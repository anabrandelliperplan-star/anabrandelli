# Preenchidas automaticamente pela Vercel ao adicionar as integrações
# Upstash Redis e Vercel Blob no painel do projeto (rode `vercel env pull .env.local`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Geradas manualmente e configuradas via `vercel env add ... production`.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
